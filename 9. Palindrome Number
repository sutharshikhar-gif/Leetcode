class Solution {
public:
    bool isPalindrome(int x) {
        long op = 0;
        int org = x;
        while(x>=1){
            int rem = x%10;
            op=op*10+rem;
            x/=10;
        }
        if(org==op){
            return true;
        }
        else{
            return false;
        }
        
    }
};
