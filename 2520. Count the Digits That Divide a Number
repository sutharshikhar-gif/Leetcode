class Solution {
public:
    int countDigits(int num) {
        int div=0;
       
        int num1 = num;
        while (num1>0){
             int i = num1%10;
            if (num%i==0){
                div ++;
            }
            num1 = num1/10;

        }
        return div;
        
    }
};
