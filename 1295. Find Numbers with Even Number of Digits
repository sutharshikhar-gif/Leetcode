class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int n=0;
        
        int t=0;
        for (int i =0 ; i<nums.size(); i++){
            int x= nums[i];
           while(x>0){
            
            t++;
            x/=10;

           }
        if(t%2==0){
            n++;
        }
        }
        return n;
        
    }
};
